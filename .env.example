# ══════════════════════════════════════════════════════════════
# GROUPE GI Archives — Variables d'environnement
# Copier ce fichier en .env et remplir toutes les valeurs.
# NE JAMAIS commiter le fichier .env.
# ══════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# ── Frontend (Vite / apps/web) ────────────────────────────────
# Ces variables sont exposées côté client — ne jamais y mettre de clés secrètes
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=CHANGE_ME_get_from_supabase_dashboard
VITE_API_URL=http://localhost:3000

# ── Supabase (DB + Auth + Storage) ────────────────────────────
# Récupérer dans : Supabase Dashboard → Settings → API

SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=CHANGE_ME_get_from_supabase_dashboard

# Service role : accès admin complet — ne jamais exposer côté client
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_get_from_supabase_dashboard

# Secret JWT (pour vérifier les tokens côté NestJS)
# Récupérer dans : Settings → API → JWT Secret
SUPABASE_JWT_SECRET=CHANGE_ME_get_from_supabase_dashboard

# ── Supabase Database (PostgreSQL) ────────────────────────────
# Récupérer dans : Settings → Database → Connection string

# URL poolée Transaction mode (pgbouncer, port 6543) — utilisée par l'API en runtime
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# URL directe (port 5432) — utilisée uniquement par Prisma migrate
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-eu-west-1.pooler.supabase.com:5432/postgres

# ── Supabase Storage ──────────────────────────────────────────
# Buckets créés automatiquement au démarrage (un par filiale)
# Format : gi-<code> (ex: gi-fomi, gi-ihl, gi-itrasagri...)
# Taille max par fichier (en MB) — aussi configuré dans Supabase Dashboard
STORAGE_MAX_FILE_SIZE_MB=50
STORAGE_BUCKET_PREFIX=gi

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── Meilisearch ───────────────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=CHANGE_ME_meili_master_key_min_16_chars
MEILI_PORT=7700

# ── Email (SMTP) ──────────────────────────────────────────────
# Dev : MailHog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@groupe-gi.com
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Prod : remplacer par SMTP réel (ou Supabase Email / Resend / SendGrid)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxx

# ── Sécurité ──────────────────────────────────────────────────
# Clé de chiffrement AES-256 pour données sensibles en base (64 caractères hex)
ENCRYPTION_KEY=CHANGE_ME_exactly_64_hex_chars_0000000000000000000000000000000

# ── Upload & OCR ──────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
MAX_BATCH_SIZE_MB=500
ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png,image/tiff,application/zip
OCR_LANGUAGES=fra+eng+swa+por
OCR_MAX_CHARS=50000

# ── Logs ──────────────────────────────────────────────────────
LOG_LEVEL=debug    # debug | info | warn | error
LOG_FORMAT=pretty  # pretty (dev) | json (prod)
